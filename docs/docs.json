{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Greg Docs",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/overview"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "colors": {
    "primary": "#A86538",
    "light": "#DE9E74",
    "dark": "#8F5327"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "aistudio",
      "grok",
      "perplexity"
    ],
    "display": "header"
  },
  "navbar": {
    "links": [
      {
        "label": "Organization",
        "href": "https://github.com/amaranthic"
      },
      {
        "label": "Report an Issue",
        "href": "https://github.com/amaranthic/greg/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/amaranthic/greg"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amaranthic/greg"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "overview",
          "quickstart",
          "installation"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "how-greg-works"
        ]
      },
      {
        "group": "Using Greg",
        "pages": [
          "threads",
          "model-providers",
          "common-workflows"
        ]
      }
    ]
  }
}
